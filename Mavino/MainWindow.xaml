<Window x:Class="Mavino.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mavino" Height="820" Width="1440"
        WindowStartupLocation="CenterScreen"
        Background="#0A0A0A"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        MinWidth="1100" MinHeight="700">

    <Window.Resources>
        <Style x:Key="DarkSlider" TargetType="Slider">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Height="22">
                            <Border Height="4" Background="#2A2A2A" CornerRadius="2" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="#E8E8E8" Height="4" CornerRadius="2" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="White" Width="14" Height="14"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" Height="4"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="20" Background="#0A0A0A" BorderBrush="#1F1F1F" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="#0A0A0A" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                        <TextBlock Text="Mavino" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="14"
                                   FontFamily="Segoe UI Variable Display, Bahnschrift, Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock Text="  ·  Local Music" Foreground="#444444" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button x:Name="PlaylistToggleBtn" Content="Лист воспроизведения"
                                Style="{StaticResource ModeChip}" Click="PlaylistToggle_Click"/>
                        <Button x:Name="LyricsToggleBtn" Content="Текст"
                                Style="{StaticResource ModeChipActive}" Click="LyricsToggle_Click"
                                Visibility="Collapsed"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                        <Button Content="⬇" Style="{StaticResource IconButton}" Width="40" Height="30" Click="Tray_Click" ToolTip="В трей" FontSize="12" Foreground="#666"/>
                        <Button Content="─" Style="{StaticResource IconButton}" Width="40" Height="30" Click="Minimize_Click" FontSize="12" Foreground="#666"/>
                        <Button Content="□" Style="{StaticResource IconButton}" Width="40" Height="30" Click="Maximize_Click" FontSize="12" Foreground="#666"/>
                        <Button Content="✕" Style="{StaticResource IconButton}" Width="40" Height="30" Click="Close_Click" FontSize="12" Foreground="#666"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main -->
            <Grid Grid.Row="1" Margin="28,10,28,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" CornerRadius="22" Background="#111111" Height="340" Margin="0,0,0,18" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="AlbumArtImage" Stretch="UniformToFill"/>
                            <Border x:Name="NoArtOverlay" Background="#90000000">
                                <TextBlock Text="♪" FontSize="90" Foreground="#222222"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="#111111" CornerRadius="22" Padding="22" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock x:Name="TrackTitleText" Text="No track loaded"
                                       Foreground="White" FontSize="19" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TrackArtistText" Text="Open a folder or files to start"
                                       Foreground="#777777" FontSize="13" Margin="0,5,0,18"
                                       TextTrimming="CharacterEllipsis"/>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="CurrentTimeText" Text="0:00" Foreground="#666" FontSize="11" VerticalAlignment="Center"/>
                                <Slider x:Name="ProgressSlider" Grid.Column="1" Margin="12,0"
                                        Minimum="0" Maximum="100" Value="0"
                                        IsMoveToPointEnabled="True" Style="{StaticResource DarkSlider}"
                                        PreviewMouseDown="ProgressSlider_PreviewMouseDown"
                                        PreviewMouseUp="ProgressSlider_PreviewMouseUp"
                                        ValueChanged="ProgressSlider_ValueChanged"/>
                                <TextBlock x:Name="TotalTimeText" Grid.Column="2" Text="0:00" Foreground="#666" FontSize="11" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Original control layout -->
                            <Grid Margin="0,14,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Button x:Name="ShuffleBtn" Style="{StaticResource IconButton}" Click="Shuffle_Click" ToolTip="Shuffle">
                                        <TextBlock Text="⇄" FontSize="16"/>
                                    </Button>
                                    <Button x:Name="FavoriteBtn" Style="{StaticResource IconButton}" Click="Favorite_Click" ToolTip="Favorite" Margin="6,0,0,0">
                                        <TextBlock x:Name="FavoriteIcon" Text="♡" FontSize="18"/>
                                    </Button>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource IconButton}" Click="Previous_Click" ToolTip="Previous">
                                        <TextBlock Text="⏮" FontSize="18"/>
                                    </Button>
                                    <Button x:Name="PlayPauseBtn" Style="{StaticResource PlayButton}" Click="PlayPause_Click" Margin="14,0" ToolTip="Play/Pause">
                                        <TextBlock x:Name="PlayPauseIcon" Text="▶" FontSize="16" Margin="2,0,0,0"/>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Click="Next_Click" ToolTip="Next">
                                        <TextBlock Text="⏭" FontSize="18"/>
                                    </Button>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="RepeatBtn" Style="{StaticResource IconButton}" Click="Repeat_Click" ToolTip="Repeat">
                                        <TextBlock x:Name="RepeatIcon" Text="🔁" FontSize="14"/>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Click="OpenFolder_Click" ToolTip="Open folder" Margin="4,0,0,0">
                                        <TextBlock Text="📁" FontSize="15"/>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Click="OpenFiles_Click" ToolTip="Open files" Margin="2,0,0,0">
                                        <TextBlock Text="＋" FontSize="18"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="🔊" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#777"/>
                                <Slider x:Name="VolumeSlider" Width="140" Minimum="0" Maximum="1" Value="0.7"
                                        ValueChanged="VolumeSlider_ValueChanged" VerticalAlignment="Center"
                                        IsMoveToPointEnabled="True" Style="{StaticResource DarkSlider}"/>
                                <TextBlock x:Name="VolumeText" Text="70%" Foreground="#555" FontSize="11"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#111111" CornerRadius="20" Padding="18">
                            <StackPanel>
                                <TextBlock Text="CLOCK" Foreground="#444" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <TextBlock x:Name="ClockTimeText" Text="15:49" Foreground="White" FontSize="30" FontWeight="Light"/>
                                <TextBlock x:Name="ClockDateText" Text="" Foreground="#555" FontSize="11" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#111111" CornerRadius="20" Padding="14">
                            <StackPanel>
                                <TextBlock Text="VISUALIZER" Foreground="#444" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <Canvas x:Name="VisualizerCanvas" Height="64" Background="Transparent"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- RIGHT -->
                <Border Grid.Column="2" Background="#111111" CornerRadius="22" Padding="28,22">
                    <Grid>
                        <!-- Lyrics -->
                        <Grid x:Name="LyricsPanel">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="LYRICS" Foreground="#555" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock x:Name="LyricsStatusText" Text="  ·  Ready" Foreground="#333" FontSize="11"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                                <Button x:Name="ModeStaticBtn" Content="Статичный" Style="{StaticResource ModeChip}" Click="ModeStatic_Click"/>
                                <Button x:Name="ModeLiveBtn" Content="Живой" Style="{StaticResource ModeChipActive}" Click="ModeLive_Click"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,14" x:Name="SourceChipsPanel"/>

                            <ScrollViewer x:Name="LyricsScrollViewer" Grid.Row="3"
                                          VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="LyricsItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,12" HorizontalAlignment="Center">
                                                <!-- Static mode: always bright full text -->
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontWeight="SemiBold"
                                                           FontSize="20" HorizontalAlignment="Center" TextAlignment="Center"
                                                           Foreground="#F0F0F0" Cursor="Hand"
                                                           MouseLeftButtonDown="LyricLine_Click" Tag="{Binding}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ForceBright}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Live mode layers -->
                                                <Grid>
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ForceBright}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontWeight="SemiBold"
                                                               FontSize="22" HorizontalAlignment="Center" TextAlignment="Center"
                                                               IsHitTestVisible="False" Foreground="#3A3A3A">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Opacity" Value="0.5"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                        <DataTrigger.EnterActions>
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.15" Duration="0:0:0.45"/>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </DataTrigger.EnterActions>
                                                                        <DataTrigger.ExitActions>
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.45"/>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </DataTrigger.ExitActions>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" TextAlignment="Center"
                                                               Cursor="Hand" MouseLeftButtonDown="LyricLine_Click" Tag="{Binding}"
                                                               Foreground="White">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Opacity" Value="0"/>
                                                                <Setter Property="FontSize" Value="22"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                        <DataTrigger.EnterActions>
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.5"/>
                                                                                    <DoubleAnimation Storyboard.TargetProperty="FontSize" To="28" Duration="0:0:0.5"/>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </DataTrigger.EnterActions>
                                                                        <DataTrigger.ExitActions>
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.4"/>
                                                                                    <DoubleAnimation Storyboard.TargetProperty="FontSize" To="22" Duration="0:0:0.4"/>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </DataTrigger.ExitActions>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock x:Name="NoLyricsPlaceholder" Grid.Row="3"
                                       Text="Нет текста.&#x0a;Откройте трек — поиск начнётся автоматически."
                                       Foreground="#2A2A2A" FontSize="15" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Playlist -->
                        <Grid x:Name="PlaylistPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <TextBlock Text="PLAYLIST" Foreground="#555" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock x:Name="PlaylistCountText" Text="  ·  0 треков" Foreground="#333" FontSize="11"/>
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                                <ItemsControl x:Name="PlaylistItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8" CornerRadius="16" Padding="10,10" Cursor="Hand"
                                                    Background="#1A1A1A" MouseLeftButtonUp="PlaylistItem_Click" Tag="{Binding Index}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="48"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="48" Height="48" CornerRadius="10" ClipToBounds="True" Background="#0A0A0A">
                                                        <Grid>
                                                            <TextBlock Text="♪" Foreground="#333" FontSize="18"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <Image Source="{Binding Cover}" Stretch="UniformToFill"/>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" Foreground="White" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Artist}" Foreground="#777" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="3" Text="{Binding Duration}" Foreground="#555" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
